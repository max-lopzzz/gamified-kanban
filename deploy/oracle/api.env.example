# Copy to /etc/gamified-kanban/api.env and fill in real values.
#   sudo mkdir -p /etc/gamified-kanban
#   sudo cp deploy/oracle/api.env.example /etc/gamified-kanban/api.env
#   sudo nano /etc/gamified-kanban/api.env
#   sudo chown root:kanban /etc/gamified-kanban/api.env && sudo chmod 640 /etc/gamified-kanban/api.env

# Bind to loopback only — Caddy (same host) proxies to it; the public
# interface never exposes the raw API.
HOST=127.0.0.1
PORT=4000

# SQLite database file, on the mounted persistent volume.
DB_PATH=/mnt/data/gamified_kanban.sqlite

# Generate once, then leave it alone (changing it invalidates all sessions):
#   openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# Frontend origin(s) allowed to call the API. Comma-separate for more than one.
CORS_ORIGIN=https://gamified-kanban.vercel.app

# Shared secret the Discord bot uses to call POST /api/bot/discord/redeem.
# MUST match /etc/gamified-kanban/bot.env. Generate once:  openssl rand -hex 32
BOT_REDEEM_SECRET=replace-with-openssl-rand-hex-32
